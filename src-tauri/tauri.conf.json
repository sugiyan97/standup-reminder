{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StandUp Reminder",
  "version": "0.1.0",
  "identifier": "com.example.standup",
  "build": {
    "beforeDevCommand": "pnpm --dir ../app dev",
    "beforeBuildCommand": "pnpm --dir ../app build",
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "security": { 
      "csp": null,
      "capabilities": ["main-capability"],
      "dangerousDisableAssetCspModification": true
    },
    "windows": [{ "title": "StandUp Reminder", "width": 480, "height": 360, "resizable": true }],
    "withGlobalTauri": true
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
